# Safe local defaults. Production binds the reserved-IP anchor address on port 22.
# Only publish port 22 AFTER testing admin SSH on a different port.
CONSOLE_BIND_IP=127.0.0.1
CONSOLE_PORT=2222

# Optional: leave these blank to browse the portfolio without email sending.
# Use a verified Resend sender/domain; never commit an API key.
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=
