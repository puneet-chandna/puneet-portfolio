[Unit]
Description=Puneet Terminal Portfolio SSH Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/terminal-portfolio
ExecStart=/opt/terminal-portfolio/portfolio
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
# Load environment variables from file
EnvironmentFile=/opt/terminal-portfolio/.env
# Set TERM for proper color rendering in SSH sessions
Environment=TERM=xterm-256color
# Allow binding to port 22
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
